# Prefer `auth login`; this override is intended for ephemeral testing only.
# SCREENAPP_ACCESS_TOKEN=

# Defaults to keychain on macOS and file elsewhere.
# SCREENAPP_CREDENTIAL_STORE=file
# SCREENAPP_CREDENTIALS_FILE=/absolute/path/to/credentials.json

# Advanced compatibility/testing overrides:
# SCREENAPP_MCP_URL=https://api.screenapp.io/v2/mcp/sse
# SCREENAPP_API_BASE_URL=https://api.screenapp.io/v2
# SCREENAPP_OAUTH_ISSUER=https://api.screenapp.io
# SCREENAPP_OAUTH_RESOURCE=https://api.screenapp.io/v2/mcp/sse
